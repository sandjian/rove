# ==============================================================================
# Rove Barbería — Variables de Entorno
# Copia este archivo a .env.local y completa con tus valores reales.
# ==============================================================================

# Base de Datos (Neon PostgreSQL)
# Para migraciones y extensiones GiST se recomienda el endpoint directo (puerto 5432).
# Ejemplo: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Autenticación Administrativa
# Clave secreta para cifrado JWE de sesiones de administrador (mínimo 32 caracteres).
ADMIN_SESSION_SECRET=

# Cifrado de Datos en Reposo (Outbox)
# Clave simétrica de 256 bits en hexadecimal (64 caracteres hex) para cifrar los payloads completos de notificaciones en email_outbox (Zero-Knowledge AES-256-GCM).
# Generar una clave segura ejecutando en terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTBOX_ENCRYPTION_KEY=

# Correos Transaccionales (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rove Barbería <reservas@midominio.com>
BARBER_NOTIFICATION_EMAIL=

# Configuración de la Aplicación y Enlaces Públicos
# Origen público para enlaces de cancelación de reservas en emails (fallback a NEXT_PUBLIC_APP_URL)
BOOKING_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seguridad de Tareas Programadas (Outbox Cron)
CRON_SECRET=
